
<!DOCTYPE html>
    <html>

    <head>
        <meta charset="UTF-8">
        <title>Дипломный проект - {{ ansible_hostname }}</title>
        <style>
            body {
                font-family: Arial;
                text-align: center;
                padding-top: 50px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                margin: 0;
                min-height: 100vh;
            }

            .container {
                background: rgba(255, 255, 255, 0.1);
                border-radius: 10px;
                padding: 30px;
                margin: 20px auto;
                max-width: 600px;
            }

            h1 {
                font-size: 2.5em;
                margin-bottom: 10px;
            }

            p {
                font-size: 1.2em;
            }

            .status {
                color: #4CAF50;
                font-weight: bold;
            }
        </style>
    </head>

    <body>
        <div class="container">
            <h1>Дипломный проект</h1>
            <p>Сервер: <strong>{{ ansible_hostname }}</strong></p>
            <p>IP: <strong>{{ ansible_default_ipv4.address }}</strong></p>
            <p class="status">✓ Работает через Docker</p>
        </div>
    </body>

    </html>
    